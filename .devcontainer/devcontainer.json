{
  "name": "Vigia — demonstração",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": ["db", "app", "servers"],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Vigia", "onAutoForward": "openBrowser" },
    "3001": { "label": "API (interna)", "onAutoForward": "silent" },
    "5432": { "label": "Banco (interno)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/LEIA-ME.md"] }
  }
}
