# Copie para .env. Nunca commite o .env.
# Conexão usada pelas migrações (dono do schema)
DATABASE_OWNER_URL=postgresql://sitedopai_owner:dev_owner_pw@localhost:5432/sitedopai
# Conexão usada pela API (sem BYPASSRLS)
DATABASE_URL=postgresql://sitedopai_app:dev_app_pw@localhost:5432/sitedopai
# Provedor de identidade (Keycloak no docker-compose)
# Login de teste sem Keycloak (escolha de usuário fictício). Troque para oidc fora do computador local.
# A API se recusa a subir com AUTH_MODE=dev quando NODE_ENV=production.
AUTH_MODE=dev
OIDC_ISSUER=http://localhost:8080/realms/sitedopai
OIDC_AUDIENCE=sitedopai-api
# Valores do claim "amr" que contam como MFA
MFA_AMR_VALUES=otp,mfa,hwk,swk
PORT=3001
# Armazenamento de fotos: local (desenvolvimento) ou s3 (S3/MinIO, bucket privado)
STORAGE_DRIVER=local
STORAGE_DIR=./.storage
# S3_BUCKET=sitedopai-dev
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=sa-east-1
CORS_ORIGINS=http://localhost:3000

# Endereço público do site, usado no QR Code dos PDFs (página /v/<código>).
PUBLIC_VERIFY_BASE_URL=http://localhost:3000

# Cobrança. Só existe o provedor simulado até a escolha do provedor real.
BILLING_PROVIDER=simulated
# Segredo HMAC dos webhooks (mínimo 24 caracteres). Troque fora do computador local.
BILLING_WEBHOOK_SECRET=dev-somente-local-troque-este-segredo
BILLING_SYNC_INTERVAL_MINUTES=60
