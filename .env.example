# Copie para .env. Nunca commite o .env.
# Conexão usada pelas migrações (dono do schema)
DATABASE_OWNER_URL=postgresql://sitedopai_owner:dev_owner_pw@localhost:5432/sitedopai
# Conexão usada pela API (sem BYPASSRLS)
DATABASE_URL=postgresql://sitedopai_app:dev_app_pw@localhost:5432/sitedopai
# Provedor de identidade (Keycloak no docker-compose)
OIDC_ISSUER=http://localhost:8080/realms/sitedopai
OIDC_AUDIENCE=sitedopai-api
# Valores do claim "amr" que contam como MFA
MFA_AMR_VALUES=otp,mfa,hwk,swk
PORT=3001
# Armazenamento de fotos: local (desenvolvimento) ou s3 (S3/MinIO, bucket privado)
STORAGE_DRIVER=local
STORAGE_DIR=./.storage
# S3_BUCKET=sitedopai-dev
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=sa-east-1
CORS_ORIGINS=http://localhost:3000
